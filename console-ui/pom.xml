<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
             http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.ufcstudy</groupId>
        <artifactId>ufc-market-value-study</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>console-ui</artifactId>
    <packaging>jar</packaging>

    <name>Console UI</name>

    <dependencies>
        <dependency>
            <groupId>com.ufcstudy</groupId>
            <artifactId>reporting</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ufcstudy</groupId>
            <artifactId>kelly-simulation</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ufcstudy</groupId>
            <artifactId>event-matching</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.ufcstudy</groupId>
            <artifactId>odds-client</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ufcstudy</groupId>
            <artifactId>persistence</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ufcstudy</groupId>
            <artifactId>polymarket-client</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ufcstudy</groupId>
            <artifactId>paper-betting</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>com.ufcstudy</groupId>
            <artifactId>settlement</artifactId>
            <version>${project.version}</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>
                        com.ufcstudy.console.ConsoleApplication
                    </mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>